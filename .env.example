# Salin menjadi .env.local (git-ignored) lalu isi. Dipakai tools/deploy.ps1.
# Alamat ESP32 di jaringan yang sama (mDNS), atau isi dengan IP.
DEPLOY_ESP_HOST=mesincuci.local
# Alamat MAC ESP32 mesin cuci (wajib): deploy dibatalkan bila perangkat di alamat itu ber-MAC lain.
# Kosongkan lalu jalankan deploy sekali untuk melihat MAC yang ditemukan, periksa, baru isi.
DEPLOY_ESP_MAC=
# Password dashboard lokal ESP32.
DEPLOY_ESP_PASSWORD=
